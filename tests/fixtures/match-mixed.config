# CAUTION: fixture for CHG-001 AC-2.1~2.3 (Match block as boundary)
Host before-block
    HostName before.example.com
    User u0
    IdentityFile ~/.ssh/id_ed25519_before

Match all
    ServerAliveInterval 30
    TCPKeepAlive yes

Host after-block
    HostName after.example.com
    User u1
    IdentityFile ~/.ssh/id_ed25519_after
